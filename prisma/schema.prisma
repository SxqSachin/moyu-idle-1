model KittyEssay {
  id        Int    @id @default(autoincrement())
  uuid      String @unique // 随笔唯一标识
  kittyUuid String // 对应猫咪的uuid
  owner     String // 所属玩家uuid

  title   String? // 随笔标题（可选）
  content String  @db.LongText // 随笔内容
