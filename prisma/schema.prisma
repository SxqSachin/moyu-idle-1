  formulaEarned  Int      @default(0)  // 新增
  bonusEarned    Int      @default(0)  // 新增
  totalEarned    Int      @default(0)  // 兼容：= formulaEarned + bonusEarned

  totalSpent    Int      @default(0) // 历史累计消耗（只增）
