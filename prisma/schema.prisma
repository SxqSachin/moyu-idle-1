// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  // runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  binaryTargets          = ["native", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = "mysql://idle_game:1234qwer@10.3.8.5:3306/idle_game_db"
  // url      = "mysql://idle_game:1234qwer@localhost:3306/idle_game_db"
}

model User {
  id    Int     @id @default(autoincrement())
  uuid  String  @unique
  name  String  @unique
  pwd   String  @default("")
  email String? @unique
  tel   String? @unique

  // Email verification
  email_verified    Boolean  @default(false)
  email_verified_at DateTime?

  mainAccountUuid String?
  accountType     String? @default("MAIN") // "MAIN" | "SUB"
  accountPlayType String? @default("NORMAL") // "NORMAL" | "IRON"

  referredBy String?

  create_date     DateTime @default(now())
  last_login_date DateTime @default(now())

  first_reset_password Boolean? @default(false)

  is_visitor Boolean? @default(false)

  avatar String @default("avatar_1")

  last_online_date DateTime @default(now())
  last_offline_date DateTime?

  last_online_ip   String   @default("")
  last_online_fp   String?

  sponsor_points     Int @default(0) // 赞助点数
  max_sponsor_points Int @default(0) // 赞助点数最大值

  is_gm Boolean @default(false)

  current_title   String @default("")
  available_title String? @db.LongText

  // 徽章
  all_badge     String @default("")
  enabled_badge String @default("")

  is_banned  Boolean @default(false) // 是否被封禁
  ban_reason String? @default("") // 封禁原因

  // 聊天禁言
  is_muted    Boolean  @default(false) // 是否被禁言（临时/永久）
  mute_until  DateTime? // 禁言截止时间（null 表示不限时，需手动解除）

  guild      String? @default("")
  guildTitle String? @default("")

  option String? @default("{}")

  profileCardEffect String?

  userGameState String? @db.LongText // 用户状态信息，存储为JSON字符串 { id: string, duration: number}

  // 上次已阅读的应用版本（用于进入游戏时自动跳转更新日志）
  last_seen_app_version String? @default("")

  // Onboarding flags
  // 是否已看过新手引导（老用户在迁移中会被回填为 true；新用户默认 false）
  has_seen_onboarding Boolean @default(false)
  // 是否新用户（用于只在首次进入时显示引导；老用户在迁移中会被回填为 false；新用户默认 true）
  is_new_user         Boolean @default(false)

  // Relations
  curioItems CurioItem[]

  @@index([uuid])
  @@index([is_muted])
  @@index([mute_until])
  @@index([last_seen_app_version])
  @@index([accountType, pwd], map: "idx_user_accountType_pwd")
  @@index([referredBy, accountType, is_banned, id], map: "idx_user_ref_ban_id")
}

/// 用户服务使用记录：用于记录赞助服务（如定制物品）的已使用次数
model UserServiceUsage {
  id        Int      @id @default(autoincrement())
  userUuid  String   // 用户uuid
  serviceKey String  // 服务键，例如 "custom_item_level_1"

  usedCount Int      @default(0)   // 已使用次数
  lastUsedAt DateTime?             // 最近一次使用时间

  extra     String?  @db.LongText  // 扩展字段（如备注、审批信息等）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userUuid, serviceKey], name: "user_service_unique")
  @@index([userUuid])
  @@index([serviceKey])
}

// 记录玩家改名历史（由GM或玩家触发）
model PlayerNameChange {
  id         Int      @id @default(autoincrement())
  user_uuid  String   // 被修改名字的用户 uuid
  old_name   String   // 旧昵称
  new_name   String   // 新昵称
  changed_by String   // 操作者 uuid（GM 或 用户自己）
  reason     String?  // 可选理由或备注
  created_at DateTime @default(now())

  @@index([user_uuid])
  @@index([changed_by])
}

/// 玩家在公会仓库的可个人提取份额（按物品汇总）
model GuildInventoryPersonalBalance {
  id        Int      @id @default(autoincrement())

  guildUuid String
  userUuid  String
  itemId    String

  /// 玩家对该物品的可用个人份额（不应小于 0）
  count     BigInt   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildUuid, userUuid, itemId], name: "guild_personal_balance_unique")
  @@index([guildUuid])
  @@index([userUuid])
  @@index([itemId])
}

model CharacterInventory {
  id             Int    @id @default(autoincrement())
  user_uuid      String @unique
  character_uuid String @unique
  inventory      String @db.LongText

  @@index([user_uuid])
  @@index([character_uuid])
}

model CharacterNewItentory {
  id             Int    @id @default(autoincrement())
  user_uuid      String // 用户uuid
  character_uuid String // 角色uuid

  item_id  String // 物品唯一标识（如物品类型id）
  count    Int // 数量
  position String? // 位置（如背包、仓库、快捷栏等，可选）

  extra String? @db.LongText // 扩展字段，如装备属性、耐久等

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_uuid])
  @@index([character_uuid])
  @@index([character_uuid, item_id])
}

model CharacterNewInventory {
  id             BigInt @id @default(autoincrement())
  user_uuid      String
  character_uuid String
  item_id        String
  count          BigInt
  position       String?
  extra          String?  @db.LongText
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([character_uuid, item_id], name: "character_uuid_item_id") // <--- 添加这一行
  @@index([user_uuid])
  // @@index([character_uuid])
  // @@index([character_uuid, item_id])
  @@index([item_id, count], name: "idx_inventory_item_count")
}

model CharacterBuilding {
  id             Int    @id @default(autoincrement())
  user_uuid      String @unique
  character_uuid String @unique
  building       String @db.LongText

  @@index([user_uuid])
  @@index([character_uuid])
}

