model Market {
  id         Int    @id @default(autoincrement())
  trade_uuid String @unique

  seller                String // 卖房
  sell_resource_id      String // 售卖资源id
  sell_resource_count   Int // 售卖资源数量
  selled_resource_count Int // 已出售的资源数量

  cost_resource_id String // 购买此资源所需的资源id
  cost_per_unit    Decimal @db.Decimal(13, 2) // 购买此资源所需的资源数量

  buyer_info String? @db.LongText

  is_closed Boolean

  create_time DateTime  @default(now())
  close_time  DateTime?

  pay_listing_fee Boolean? @default(false) // 是否支付了上架手续费

  @@index([seller, create_time], name: "idx_market_seller_created")
  @@index([trade_uuid])
  @@index([sell_resource_id, is_closed, cost_per_unit], name: "idx_market_sell_closed_cost")
}

model BuyerMarket {
  id         Int    @id @default(autoincrement())
  trade_uuid String @unique

  buyer                  String // 买方
  require_resource_id    String // 售卖资源id
  require_resource_count Int // 售卖资源数量
  done_resource_count    Int // 已出售的资源数量

  pay_resource_id String // 购买此资源所需的资源id
  pay_per_unit    Decimal @db.Decimal(13, 2) // 购买此资源所需的资源数量

  is_closed Boolean

  create_time DateTime  @default(now())
  close_time  DateTime?

  seller_info String? @db.LongText

  // 预先扣除的市场税
  pre_deducted_market_tax Int? @default(0)

  @@index([trade_uuid])
  @@index([require_resource_id, is_closed, pay_per_unit], name: "idx_buyermarket_require_closed_pay")
  @@index([buyer], name: "idx_buyermarket_buyer")
  @@index([buyer, is_closed], name: "idx_buyermarket_buyer_closed")
}

model ChatMessage {
  id          Int    @id @default(autoincrement())
  sender      String // 用户uuid
  sender_name String // 发送者昵称（冗余，方便展示）

  receiver_id   String? // 接收者uuid（私聊时用）
  receiver_name String? // 接收者name （私聊时用）

  content String // 消息内容

  extraSFX String? // 附加的特效

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  is_revoked Boolean @default(false) // 是否撤回
  is_deleted Boolean @default(false) // 是否删除
  extra      String? @db.LongText // 扩展字段(JSON)，如图片URL、文件信息等

  extra2 String? @db.LongText // 扩展字段(JSON)，如图片URL、文件信息等

  @@index([receiver_id, is_deleted, created_at], name: "idx_chat_receiver_created")
  @@index([sender, is_deleted, created_at], name: "idx_chat_sender_created")
}

/// 玩家屏蔽关系表：一条记录表示 blockerUuid 对 targetUuid 的屏蔽设置。
/// 当前仅使用 blockPublic（屏蔽公屏/铁猫公屏），预留 blockPrivate / blockAll 供后续扩展。
model UserBlock {
  id           Int      @id @default(autoincrement())
  blockerUuid  String   // 发起屏蔽的玩家
  targetUuid   String   // 被屏蔽的玩家

  // 通用屏蔽类型开关（按需拓展）
  blockPublicChat   Boolean @default(true)  // 屏蔽公屏/铁猫公屏
  blockPrivateChat  Boolean @default(false) // 屏蔽私聊
  blockGuildChat    Boolean @default(false) // 屏蔽公会聊天（预留）
  blockRoomChat     Boolean @default(false) // 屏蔽房间聊天（预留）
  blockBattleInvite Boolean @default(false) // 屏蔽战斗相关邀请（预留）
  blockTrade        Boolean @default(false) // 屏蔽交易请求（预留）
  blockAll          Boolean @default(false) // 完全屏蔽（优先级最高）

  reason    String?  // 可选：玩家自定义或系统记录屏蔽原因
  extra     String?  @db.LongText // JSON 结构，存储可扩展字段

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 唯一约束：同一对关系只保留一条记录
  @@unique([blockerUuid, targetUuid], name: "blocker_target_unique")
  @@index([blockerUuid])
  @@index([targetUuid])
  @@index([blockerUuid, blockAll])
  @@index([blockerUuid, blockPublicChat])
}

model Quest {
  id             Int     @id @default(autoincrement())
  uuid           String  @unique
  title          String
  actionMainType String // AllGameActionMainType
  description    String?
  executor       String // 用户uuid或角色uuid
  difficulty     Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  completedAt DateTime?
  dueDate     DateTime?

  status String // "PENDING" | "DOING" | "DONE" | "REROLL" | "EXPIRED"

  targetActionId     String
  targetGoalCount    Int
  targetCurrentCount Int

  rerollCount Int @default(0)

  rewards String @db.LongText

  @@index([uuid])
  @@index([executor])
  @@index([targetActionId])
  @@index([status])
}

model Kitty {
  id    Int    @id @default(autoincrement())
  uuid  String @unique
  owner String

  name String

  satiety     Float @default(0)
  max_satiety Float @default(100)

  mood     Float @default(100) // 新增：心情值，范围可自定义
  max_mood Float @default(100) // 新增：心情值，范围可自定义

  is_working Boolean?
  action_id  String?

  isInExpedition Boolean @default(false) // 是否在探险中
  expeditionUuid String? // 探险的uuid（如果在探险中）

  @@index([uuid])
  @@index([owner])
