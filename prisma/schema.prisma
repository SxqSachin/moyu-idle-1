model CharacterUnitInfo {
  id             Int    @id @default(autoincrement())
  user_uuid      String @unique
  character_uuid String @unique

  name String @default("")

  level Int @default(1) // 力量

  strength     Int // 力量
  dexterity    Int // 敏捷
  intelligence Int // 智力
  stamina      Int // 耐力

  attacking Int // 攻击
  defencing Int // 防御

  otherStatus String? @db.LongText // 其他状态信息，存储为JSON字符串

  max_hp     Int @default(100)
  current_hp Int @default(100)

  max_mp     Int @default(100)
  current_mp Int @default(100)

  ability String @db.LongText // 可用技能列表，存储为JSON字符串
  ai      String @db.LongText

  equipment String? @db.LongText // 装备信息，存储为JSON字符串
  inventory String? @db.LongText // 物品袋信息，存储为JSON字符串

  skillTreeNodes String? @db.LongText // 学习的技能树节点，存储为JSON字符串
  affix String? @db.LongText // 角色词缀，存储为JSON字符串

  ip String @default("")

  fp String? @db.LongText

  @@index([user_uuid])
  @@index([character_uuid])
}

model CharacterSkillInfo {
  id             Int    @id @default(autoincrement())
  user_uuid      String
  character_uuid String

  skill_id String @default("")
  level    Int    @default(0)
  exp      Float  @default(0)

  enabled Boolean @default(true) // 是否启用技能
  logic   String? @db.LongText

  order Int @default(0)

  extra  String? @db.LongText

  available Boolean @default(true) // 是否可用（未被禁用）

  @@index([user_uuid])
  @@index([character_uuid])
  @@index([character_uuid, user_uuid, skill_id])
  @@unique([character_uuid, user_uuid, skill_id], name: "character_user_skill_unique")
}

model CharacterSkillOutfit {
  id Int @id @default(autoincrement())

  uuid String @unique

  user_uuid      String
  character_uuid String

  name String

  data String @db.LongText

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_uuid])
  @@index([character_uuid])
}

model CharacterBattleInventoryInfo {
  id            Int    @id @default(autoincrement())
  userUuid      String
  characterUuid String

  resourceId String? @default("")

  resourceRemainingCount Int @default(0) // 剩余数量
  resourcePrepareCount   Int @default(0) // 准备数量

  order Int @default(0)

  ai String? @db.LongText

  useWhen String? // 使用时机，如 'selfTurnStart' | 'battleStart'，逗号分割数组

  @@index([userUuid])
  @@index([characterUuid])
  @@index([characterUuid, userUuid, resourceId])
}

