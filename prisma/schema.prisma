  matchStage1Reward      Boolean @default(false) // 是否已获得匹配阶段奖励
  referrerRewardedStage1 Boolean @default(false) // 推荐人是否已获得奖励
  referredRewardedStage1 Boolean @default(false) // 被推荐人是否已获得奖励

  referrerStage1RewardAt DateTime? // 推荐人奖励发放时间
  referredStage1RewardAt DateTime? // 被推荐人奖励发放时间

  // 奖励发放记录
  matchStage2Reward      Boolean @default(false) // 是否已获得匹配阶段奖励
  referrerRewardedStage2 Boolean @default(false) // 推荐人是否已获得奖励
  referredRewardedStage2 Boolean @default(false) // 被推荐人是否已获得奖励

  referrerStage2RewardAt DateTime? // 推荐人奖励发放时间
  referredStage2RewardAt DateTime? // 被推荐人奖励发放时间

  // 验证相关
  confirmedAt DateTime? // 推荐确认时间（如被推荐人完成某些任务后）
  ipAddress   String? // 注册时IP（防作弊）
  fingerprint String? // 设备指纹（防作弊）

  // 时间记录
  createdAt DateTime @default(now()) // 推荐创建时间
  updatedAt DateTime @updatedAt // 更新时间

  confirmedByReferred Boolean @default(false) // 被推荐人是否确认了关系
  // 绑定时的奖励快照，避免后续修改影响已确认邀请
  confirmReferredRelationRewardSnapshot String? @db.LongText // JSON，来源于邀请人的 UserInviteRewardSetting.rewardPayload，指本次确认时获取到的奖励

  // 扩展字段
  extra String? @db.LongText // 扩展信息（JSON格式）

  @@unique([referrerUuid, referredUuid], name: "user_referral_unique")
  @@index([referrerUuid]) // 推荐人查询索引
  @@index([referralCode]) // 推荐码查询索引
  @@index([status]) // 状态查询索引
  @@index([referrerUuid, status]) // 复合索引
}

model Auction {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) // 拍卖唯一标识

  is_admin_action Boolean @default(false) // 是否为管理员操作的拍卖（如活动赠送等）

  creator     String // 创建者（用户 uuid）
  target_type String // 多态目标类型，如 "ITEM" | "TITLE" | "SHOP" | "BUILDING" | ...

  target_id String // 业务目标 ID（目标实体的外部 id）
  target_count BigInt @default(1) // 目标数量（如拍卖多个相同物品）

  metadata String? @db.LongText // 可扩展 JSON：例如物品快照、标题描述、预览图等

  state         String  @default("OPEN") // OPEN | ENDED | CANCELLED | SETTLED
  start_price   BigInt // 起价
  reserve_price BigInt? // 保留价（可选）
  buyout_price  BigInt? // 一口价（可选，立即成交）
  min_increment BigInt  @default(1) // 最小加价幅度

  start_at          DateTime  @default(now())
  end_at            DateTime // 拍卖结束时间（UTC）
  extension_seconds Int?      @default(0) // 反延迟窗口（秒），若在结束前 N 秒有出价则延长
  extended_until    DateTime? // 若被延长，记录延后后的时间（可选）

  deposit_required BigInt? // 押金/保证金金额（可选）
  deposit_token    String? // 押金货币类型（如 "gold" / "coin" / "iron"）

  winner      String? // 成交者 uuid（结算时写入）
  final_price BigInt? // 成交价（结算时写入）

  extra      String?  @db.LongText // 扩展字段（策略、拍卖规则等 JSON）
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([state])
  @@index([target_id])
  @@index([is_admin_action])
  @@index([creator])
  @@index([end_at])
}

model AuctionBid {
  id           Int      @id @default(autoincrement())
  auction_uuid String // 关联 Auction.uuid
  bidder       String // 出价人（用户 uuid）
  amount       BigInt // 本次出价金额（实际生效金额）
  max_proxy    BigInt // 代理出价上限（若启用 proxy bidding）
  is_proxy     Boolean  @default(false) // 是否代理出价记录
  refunded     Boolean  @default(false) // 押金/未成交退款标记
  extra        String?  @db.LongText // 扩展信息（如渠道、ip、设备指纹）
  created_at   DateTime @default(now())

  @@index([auction_uuid])
  @@index([bidder])
  @@index([auction_uuid, amount], name: "auction_amount_idx")
}

