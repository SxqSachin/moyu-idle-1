model KittyEncounter {
  id            Int      @id @default(autoincrement())
  fromKittyUuid String // 发起偶遇的猫咪uuid
  toKittyUuid   String // 被偶遇的猫咪uuid
  encounterTime DateTime @default(now()) // 偶遇时间
  location      String? // 偶遇地点（可选）
  description   String? // 偶遇描述（可选）
  extra         String?  @db.LongText // 扩展字段（如图片、标签等）
  // @@unique([fromKittyUuid, toKittyUuid])

  @@index([fromKittyUuid])
  @@index([toKittyUuid])
}

model KittyFriendship {
  id               Int      @id @default(autoincrement())
  kittyAUuid       String // 猫咪A的uuid
  kittyBUuid       String // 猫咪B的uuid
  ownerA           String // 猫咪A所属玩家uuid
  ownerB           String // 猫咪B所属玩家uuid
  becomeFriendTime DateTime @default(now()) // 成为好友的时间
  intimacy         Float    @default(1) // 好友亲密度，可用于后续玩法
  extra            String?  @db.LongText // 扩展字段

  del Boolean @default(false) // 是否删除好友关系

  @@unique([kittyAUuid, kittyBUuid])
  @@index([kittyAUuid])
  @@index([kittyBUuid])
  @@index([ownerA])
  @@index([ownerB])
}

model KittyExpeditionTeam {
  id   Int    @id @default(autoincrement())
  uuid String @unique // 探险队唯一标识

  owner String // 队伍归属玩家uuid
  name  String // 队伍名称

  guildUuid String? // 公会ID（可选）

  kittyUuids String @db.LongText // 队伍成员（猫咪uuid数组，JSON字符串）
  state      String @default("IDLE") // 队伍状态："IDLE" | "EXPEDITION" | "RETURNING" | "FINISHED"

  turn Int // 当前轮次（可选）

  expeditionAreaId String? // 当前探险任务ID（可选）

  lastRewardAt DateTime? // 上次奖励发放时间（可选）

  startTime DateTime? // 探险开始时间
  endTime   DateTime? // 探险结束时间

