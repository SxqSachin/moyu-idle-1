/// 种植田地状态
enum FarmPlotState {
  LOCKED   // 未解锁
  EMPTY    // 已解锁，未种植
  GROWING  // 生长中（包含发芽/生长期）
  READY    // 可收获
  WITHERED // 失养分/超时导致的枯萎（可选流程）
}

/// 每个用户的种植田地
model UserFarmPlot {
  id    Int    @id @default(autoincrement())
  uuid  String @unique @default(uuid()) // 田地实例唯一ID

  userUuid  String // 所属玩家
  plotIndex Int    // 田地序号（同一用户内唯一）

  state FarmPlotState @default(LOCKED)

  // 作物信息（未种植时为空）
  seedId String? // 作物/种子资源ID（参考 allGameResource）

  // 本轮种植配置
  fertilizers   String?  @db.LongText // 使用的肥料（JSON 数组：[{ id: string, stacks?: number }]）
  expectedYield String?  @db.LongText // 预计算的产出（JSON：ResourceRequirement[]）
  mutationChance Float?  // 最终变异概率（0~1），可选

  // 生长与离线推进
  plantedAt              DateTime? // 播种时间
  expectedHarvestAt      DateTime? // 预计成熟/收获时间（便于前端展示）
  growthSecondsRequired  Int?      // 本次作物所需总生长时长（秒），冗余记录方便结算
  growthSecondsAccumulated Int     @default(0) // 已累计的生长时长（秒）
  lastTickAt             DateTime? // 上次离线推进时间戳

  // 简化的养护/自动化
  autoReplant Boolean @default(false) // 收获后自动播种同种作物
  config      String?  @db.LongText   // 配置JSON（施肥策略、替代种子、优先级等）
  extra       String?  @db.LongText   // 扩展字段

  // 田地分区（预留：自宅/公会花园等），默认 home
  area String @default("home")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userUuid, plotIndex], name: "user_plot_unique")
  @@index([userUuid])
  @@index([seedId])
  @@index([state])
}

/// 收获箱来源枚举（系统通用，不绑定具体业务）
enum HarvestBoxSource {
  Auto // 系统自动产生（如自动收获、自动任务）
  Manual // 手动触发（如手动收获、手动奖励）
  Event // 活动/赛事/活动脚本
  Mail  // 系统邮件或投递
  GM    // GM或后台发放
  Other // 其他未分类来源
  ActionExtraReward
  ActionDeductReturn
}

/// 通用收获箱：用于系统中记录任何来源的“待领取”产出（例如自动收获、活动奖励、邮件发送的物品等）
model HarvestBox {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())

  userUuid  String   // 接收用户的 uuid

  // 可选来源标识（通用枚举）
  source    HarvestBoxSource?
  sourceId  String?  // 可选的来源关联 id（例如某个任务/日志 id）

  // 人类可读短标题或说明
  title     String?

  // 任意扩展字段（JSON），用于保存原始播种配置快照或其他元数据
  extra     String?  @db.LongText

  // 过期时间（可选），到期后可由后台清理或转为系统邮件
  expiresAt DateTime?

  // 是否已整体领取（若支持按项领取，可忽略此字段）
  claimed   Boolean  @default(false)
  claimedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联明细
  items HarvestBoxItem[]

  @@index([userUuid])
  @@index([createdAt])
  @@index([userUuid, claimed, id], name: "idx_harvestbox_user_claimed_id")
}

/// 收获箱明细条目，每条记录一种资源及数量，可扩展 meta
model HarvestBoxItem {
  id           Int      @id @default(autoincrement())
  harvestBoxId Int

  // 资源 id（对应 allGameResource 中的 id）
  resourceId   String

  // 数量（使用 BigInt 与库存表保持一致）
  amount       BigInt   @default(0)

  // 可选元数据（例如品质/来源种子 id 等）
  meta         String?  @db.LongText

  // 如果需要按条目领取，可用以下字段
  claimed      Boolean  @default(false)
  claimedAt    DateTime?

  createdAt    DateTime @default(now())

  // 关联到父箱子
  harvestBox   HarvestBox @relation(fields: [harvestBoxId], references: [id], onDelete: Cascade)

  @@index([harvestBoxId])
  @@index([resourceId])
}

/// 征战圣火纪念碑供奉记录（用于计算实时排行榜）
/// 设计：每次供奉插入一条连续时间段记录 [startAt, endAt)，按用户累加，当前剩余时长依赖 now()
model VillageDurationDonateContribution {
  id       Int      @id @default(autoincrement())
  userUuid String   // 供奉的玩家 uuid

  type     String

  // 本次供奉生效窗口，半开区间 [startAt, endAt)
  startAt DateTime  // 生效开始时间（若此前有未结束的供奉，则从上一条 endAt 开始）
  endAt   DateTime  // 生效结束时间 = startAt + minutes

  // 冗余字段：供奉分钟数，便于统计和校验
  minutes Int

  createdAt DateTime @default(now())

  @@index([userUuid])
  @@index([startAt])
  @@index([endAt])
  @@index([userUuid, endAt])
}

/// 玩家自营商店（离线商店/仓库）
/// 规则：支付租期费用后在有效期内保持 OPEN；到期自动转为 EXPIRED，并回退未售出库存到 HarvestBox
model PlayerShop {
  id    Int    @id @default(autoincrement())
  uuid  String @unique @default(uuid()) // 商店唯一标识

  owner String // 店主用户 uuid

  name        String
  description String? @db.LongText

  // 可见性：PUBLIC | GUILD | PRIVATE（先用字符串，保持与现有风格一致）
  visibility String  @default("PUBLIC")

  // 店铺状态：OPEN | PAUSED | CLOSED | EXPIRED | REMOVED
  state String @default("OPEN")

  // 有效期：到此时间后自动失效（定时任务/请求时检测并切换状态）
  expiresAt DateTime
  
  extra String? @db.LongText // 扩展字段（规则、公告等）

  // 冗余：公会/分区可选
  guildUuid String?
  area      String? // 如 home / market / guild

  sellResource String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([owner])
  @@index([state])
  @@index([expiresAt])
  @@index([guildUuid])
}

/// 商店库存与定价（上架项）：将物品从角色背包转移到店铺托管
model PlayerShopItem {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  shopUuid  String // 归属商店
  sellerUuid String // 冗余：店主用户 uuid

  // 资源与库存
  resourceId     String


  inventoryRemainingCount BigInt  @default(0) // 库存保留数量
  soldCount      BigInt  @default(0) // 历史售出

  // 定价
  unitPrice          Decimal @db.Decimal(13, 2)
  currencyResourceId String

  // 购买限制（可选）
  // minPurchase BigInt @default(1)
  // maxPerUser  BigInt @default(0) // 0 表示不限制

  // 状态：ACTIVE | HIDDEN | OUT | REMOVED
  state String @default("ACTIVE")

  metadata String? @db.LongText // 附加信息（如品质、附魔等）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopUuid])
  @@index([shopUuid, state])
  @@index([resourceId])
  @@index([unitPrice])
}

/// 玩家店铺购买记录表
/// 记录每次从玩家店铺购买的明细，用于追踪、统计与审计
model PlayerShopPurchase {
  id    Int    @id @default(autoincrement())
  uuid  String @unique @default(uuid()) // 购买记录唯一标识

  // 参与者与归属
  buyerUuid  String // 购买者用户 uuid
  sellerUuid String // 卖家用户 uuid（冗余自上架项）
  shopUuid   String // 商店 uuid
  itemUuid   String // 上架项 uuid

  // 购买内容
  resourceId          String            // 购买的资源 id
  currencyResourceId  String            // 货币资源 id（通常为 gold）
  unitPrice           Decimal @db.Decimal(13, 2) // 成交单价（冗余记录当时价格）
  count               Int               // 购买数量
  totalCost           BigInt            // 实际支付总额（整数，兼容金币）

  // 备查信息（可选）
  itemSnapshot String? @db.LongText // 购买时上架项快照（如 metadata、阈值等）
  extra        String? @db.LongText // 其他扩展信息（如渠道、ip、备注）

  // 状态（预留字段，当前固定为 SUCCESS）
  state String @default("SUCCESS") // SUCCESS | REFUNDED | CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerUuid])
  @@index([sellerUuid])
  @@index([shopUuid])
  @@index([itemUuid])
  @@index([resourceId])
  @@index([createdAt])
}

/// ========================= 随机词条（Affix）系统（简化版） =========================

/// 词条稀有度（保留在库内，仅用于实例/统计；定义与池在代码侧）
enum AffixRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

/// 角色词条状态
enum CharacterAffixState {
  ACTIVE
  INACTIVE
  LOCKED
}

/// 角色已拥有的词条（每条记录一个词条实例；允许同词条多条记录进行叠加）
model CharacterAffix {
  id            Int    @id @default(autoincrement())
  userUuid      String
  characterUuid String

  affixId String // 由代码侧定义的数据集提供
  rarity  AffixRarity

  /// 具体生效效果（JSON）：已解析为实际数值
  /// 例如 {"add":{"maxHp":9}, "mul":{}}
  effect String @db.LongText

  /// 排序/评估用（可选）
  score Decimal @db.Decimal(13, 4)

  state  CharacterAffixState @default(ACTIVE)
  source String? // INITIAL | REROLL | EVENT | GM ...
  seed   String? // 随机种子（可审计）

  /// 并发控制：乐观锁版本号
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userUuid])
  @@index([characterUuid])
  @@index([affixId])
  @@index([state])
  @@index([rarity])
  @@index([characterUuid, state])
}

/// 词条操作日志：初始化/重铸/增删的审计记录
model CharacterAffixLog {
  id            Int    @id @default(autoincrement())
  userUuid      String
  characterUuid String
  action        String // INITIALIZE | REROLL | ADD | REMOVE | UPDATE

  before String? @db.LongText // JSON：操作前词条快照（数组）
  after  String? @db.LongText // JSON：操作后词条快照（数组）
  cost   String? @db.LongText // JSON：资源消耗
  result String? @db.LongText // JSON：结果/错误信息

  createdAt DateTime @default(now())

  @@index([userUuid])
  @@index([characterUuid])
  @@index([action])
  @@index([createdAt])
}

/// 通用的“玩家槽位扩展”记录表
/// 用于存储每个用户在不同系统中的额外槽位上限增量。
/// 例如词条系统的“启用上限/持有上限”扩展，未来也可在此表新增字段支持其他系统（农场、背包、商店等）。
model UserSlotExpansion {
  id       Int    @id @default(autoincrement())
  userUuid String @unique // 每个用户一条记录

  // 词条系统扩展量（相对于默认常量的增量）
  extraAffixMaxActive Int @default(0) // 额外“启用上限
  extraAffixMaxOwned  Int @default(0) // 额外“持有上限”

  // 市场扩展：额外允许的卖家上架/买家求购交易数（相对于 BASE_MAX_* 常量的增量）
  extraMarketMaxSellerTransactions Int @default(0)
  extraMarketMaxBuyerTransactions  Int @default(0)

  // 每个扩展方案已使用的次数（按方案分开计数，便于审核与限额控制）
  // Market seller schemes
  marketSellerSchemeUsage_schemeA Int @default(0)
  marketSellerSchemeUsage_schemeB Int @default(0)
  // Market buyer schemes
  marketBuyerSchemeUsage_schemeA Int @default(0)
  marketBuyerSchemeUsage_schemeB Int @default(0)

  // 玩家店铺扩展：额外允许的店铺上架槽位数（相对于 BASE_MAX_PLAYER_SHOP_ITEM_SLOT 的增量）
  extraPlayerShopItemSlots Int @default(0)

  // 玩家店铺：按方案统计的已使用扩展次数
  playerShopSchemeUsage_default Int @default(0)
  playerShopSchemeUsage_fast    Int @default(0)

  // 预留：扩展字段（JSON），可存放非结构化的扩展信息
  extra String? @db.LongText

  // 词条系统：按方案统计的已使用持有扩展次数（用于 CHARACTER_AFFIX_OWNED 扩展方案的区分）
  affixOwnedSchemeUsage_schemeA Int @default(0)
  affixOwnedSchemeUsage_schemeB Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userUuid])
}

model UserPersonalization {
  id             Int      @id @default(autoincrement())
  user_uuid      String   @unique
  favorite_items String?  @db.LongText // JSON array string, e.g. '["item_a","item_b"]'
  category_order String?  @db.LongText // JSON array string of category keys, e.g. '["mine","workEquipment","battleEquipment","..."]'
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([user_uuid])
}

/// ========================= 钓鱼系统相关模型 =========================
/// 设计原则：尽量保持与现有 schema 的风格一致（JSON 使用 LongText 保存），
/// 数据以 `userUuid` / `characterUuid` 字段为主索引方便查询。

// Pond / PondPoint / FishSpecies / PondPointSpecies are intentionally omitted.
// 您选择在代码侧与 JSON 数据中定义池塘、点位分布与鱼种信息。
// 因此数据库仅记录玩家选择的坐标和会话快照（toolConfig、rngSeed 等）。

/// 每次玩家进行的钓鱼会话记录（允许回放/查询）
// Enums for fishing session actions and actor types
enum EndAction {
  STOP
  CONTINUE
}

enum ActorType {
  PLAYER
  KITTY
}

model FishingSession {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique // 会话唯一标识
  userUuid      String   // 玩家 uuid
  characterUuid String?  // 可选角色 uuid
  // 玩家在地图上任意选择的点，以坐标存储（点位非固定）
  pointX        Float
  pointY        Float
  pondId        String  // 可选：地图/区域标识，便于多地图扩展
  startAt       DateTime @default(now())
  endAt         DateTime?
  durationSec   Int?     // 持续时长（秒），冗余字段便于快速查询

  // 本次使用的道具配置与快照（JSON，记录物品 id 与属性，例如 { rod: "rod_01", bait: "worm", net: "net_01" }）
  toolConfig    String?  @db.LongText

  baitConfig    String?  @db.LongText
  // 结束条件：支持可扩展的 JSON 列表，允许定义多个条件，任一条件触发即可
  // 例如: [{ type: "DURATION", value: 300 }, { type: "COUNT", value: 10 }]
  endConditions Json?
  // 钓鱼结束后的动作（使用 enum）：STOP 表示结束会话；CONTINUE 表示触发后继续
  endAction EndAction @default(STOP)

  // 出战者信息：区分是玩家本人出马还是 Kitty（小猫）出马
  // actorType 使用 enum：PLAYER | KITTY；当为 KITTY 时，可在 actorId 中存放 kitty 的 id
  actorType ActorType @default(PLAYER)
  actorId   String

  status        String @default("ONGOING") // ONGOING | COMPLETED | CANCELLED | ERROR

  // 随机数种子：用于确保在相同 (player + config + position + time) 下能生成可复现的产出
  // 由服务端生成（例如 64 位整数或 hex 字符串），客户端/服务端在结算时使用该种子
  rndSeed String @db.VarChar(64)

  // 汇总结果的缓存（JSON），以及完整明细通过 CaughtFish 关联
  resultSummary String?  @db.LongText

  // 可选：查询附近玩家时的缓存（例如显示昵称/头像的简要信息）
  visiblePlayers String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catches CaughtFish[]

  @@index([userUuid])
  @@index([startAt])
  @@index([pondId])
}

/// 单条捕获记录（一条记录代表一次“钓上来”的鱼）
model CaughtFish {
  id            Int      @id @default(autoincrement())
  userUuid      String   // 玩家 uuid
  sessionId     String
  // fish species identified by code/string (由代码侧/JSON 数据定义)
  pondId        String
  fishId        String
  length        Float    // 随机生成，范围由 species 定义
  weight        Float
  quality       Int     // 品质等级（可选）
  caughtAt      DateTime @default(now())
  extra         String?  @db.LongText // 额外属性，如附加掉落、是否是活动鱼等

  createdAt DateTime @default(now())

  session FishingSession @relation(fields: [sessionId], references: [uuid], onDelete: Cascade)

  asResource    Boolean @default(false) // 是否是一种资源
  resourceResult String?  @db.LongText  // 若作为资源，记录资源产出（JSON）

  @@index([asResource], name: "idx_caughtfish_as_resource")
  @@index([asResource, fishId, weight], name: "idx_caughtfish_asres_fishid_weight")
  @@index([asResource, fishId, length], name: "idx_caughtfish_asres_fishid_length")
  @@index([userUuid])
  @@index([sessionId])
  @@index([fishId])
  @@index([pondId])
  @@index([caughtAt])
}

/// 钓鱼道具模板：定义道具类型与效果（弧度由服务端逻辑解析）
// 钓鱼道具由游戏逻辑在代码中维护，不在数据库建模（道具影响在会话 `toolConfig` 中快照存储）

/// 为方便统计，记录活跃钓鱼会话（可以用作缓存/实时查询）
model ActiveFishingSession {
  id         Int      @id @default(autoincrement())
  sessionId  String   @unique
  userUuid   String
  pointX     Float
  pointY     Float
  pondId      String?
  startedAt  DateTime @default(now())

  // inherit deterministic rnd seed from session
  rndSeed String @db.VarChar(64)

  // Mirror session-level end-conditions and actor info to make scheduling decisions easier
  endConditions Json?
  endAction EndAction @default(STOP)
  actorType ActorType @default(PLAYER)
  actorId   String

  @@index([userUuid])
  @@index([userUuid, pondId])
}

/// 玩家创建的钓鱼区域（诱饵/诱鱼区域）
model FishingBaitArea {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())

  // 创建者（玩家 uuid）
  creatorUuid  String

  // 可选关联钓场（pond）
  pondId    String?

  // 区域圆心坐标
  pointX    Float
  pointY    Float
  // 区域半径（单位与地图坐标系一致）
  radius    Float

  // 使用的饵料 id（字符串），用于在 worker 中查找对应效果
  baitId    String

  // 可选的效果负载（JSON），例如 { "percentBoost": 0.2, "weightBoost": 1.5 }
  effect    Json?

  // 生效时间
  startedAt DateTime @default(now())
  // 过期时间（null 表示永久或手动删除）
  expiresAt DateTime?

  // 活跃标志（逻辑删除/禁用）
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorUuid])
  @@index([pondId])
  @@index([expiresAt])
}

/// ========================= 结束：钓鱼模型 =========================

/// ========================= 世界Boss伤害统计 =========================
model WorldBossDamageRecord {
  id          Int      @id @default(autoincrement())
  uuid        String
  bossId      String
  roomId      String
  playerUuids String   @db.LongText // JSON 数组字符串，记录房间内所有玩家 uuid
  totalDamage BigInt
  createdAt DateTime @default(now())
  settledAt   DateTime @updatedAt

  @@unique([uuid, roomId], name: "boss_room_unique")
  @@index([bossId, settledAt])
  @@index([bossId])
  @@index([roomId])
  @@index([totalDamage])
}

/// 记录每一场世界Boss战斗的奖励分发状态，防止重复分发
model WorldBossRewardDistribution {
  id           Int     @id @default(autoincrement())
  uuid         String                 // worldBossBattleUuid
  bossId       String
  roomId       String?  @db.LongText  // 可选：所属房间
  playerUuid   String
  rewards      String?  @db.LongText  // JSON：奖励内容（ItemCountInfo-like）
  processed    Boolean  @default(false)
  processedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([uuid, playerUuid], name: "uuid_player_unique")
  @@index([bossId, processed])
}

/// ========================= 古董（AI 生成） =========================
model CurioItem {
  id                 Int      @id @default(autoincrement())
  uuid               String   @unique @default(uuid())
  owner              String   // 拥有者用户 uuid
  ownerUser          User     @relation(fields: [owner], references: [uuid])
  name               String
  description        String   @db.LongText
  lore_tag           String
  rarity             Int

  extra              String?  @db.LongText // 扩展字段（JSON）

  is_deleted         Boolean  @default(false)

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([owner], name: "idx_curio_owner")
  @@index([rarity, lore_tag], name: "idx_curio_rarity_tag")
  @@index([created_at], name: "idx_curio_created")
  @@index([lore_tag], name: "idx_curio_lore_tag")
  @@fulltext([name, description])
}

/// ========================= 成就系统模型 =========================
model UserAchievement {
  id               Int      @id @default(autoincrement())
  userUuid       String
  achievementId  String
  progress         BigInt   @default(0)
  target           BigInt?
  completed        Boolean  @default(false)
  completedAt      DateTime?
  extra            String?  @db.LongText
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userUuid, achievementId], name: "user_achievement_unique")
  @@index([userUuid])
  @@index([achievementId])
}

/// 用于高频计数的缓存表（可选：同步到 Redis；此表用于持久化/补偿）
model UserAchievementCounter {
  id        Int      @id @default(autoincrement())
  userUuid String 
  key       String                                    // e.g. "item:iron" or "kill:goblin"
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userUuid, key], name: "user_achievement_counter_unique")
  @@index([userUuid])
	@@map("UserAchievementCounter")
}

/// 审计事件：保存原始事件以便回放/补偿
model AchievementEvent {
  id         Int      @id @default(autoincrement())
  eventId    String?  @unique                               // 如果外部事件带有 id，用于去重
  userUuid String?
  type       String
  payload    String?  @db.LongText                          // JSON string
  processed  Boolean  @default(false)
  processedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([userUuid])
}

/// 记录已发放的奖励（幂等/审计）
model AchievementRewardLog {
  id              Int      @id @default(autoincrement())
  userUuid      String
  achievementId String
  reward          String?  @db.LongText
  grantedAt       DateTime @default(now())

  @@index([userUuid])
  @@index([achievementId])
  @@unique([userUuid, achievementId, grantedAt], name: "reward_unique_per_time")
}