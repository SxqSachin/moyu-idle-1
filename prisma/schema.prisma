  user_uuid      String @unique
  character_uuid String @unique

  collecting String? @db.LongText // 采集
  mining     String? @db.LongText // 采矿

  fishing String? @db.LongText 

  farmingAnimal String? @db.LongText // 畜牧
  farmingPlant  String? @db.LongText // 种植
  cooking       String? @db.LongText // 烹饪
  manufacturing String? @db.LongText // 制造
  forging       String? @db.LongText // 锻造
  sewing        String? @db.LongText // 锻造
  trading       String? @db.LongText // 交易
  knowledge     String? @db.LongText // 学识
  exploring     String? @db.LongText // 探索

  enhance String? @db.LongText // 神秘

  mysterious String? @db.LongText // 神秘

  luck String? @db.LongText // 幸运

  battle String? @db.LongText // 战斗

