  goldSpent  BigInt @default(0) @db.UnsignedBigInt // 本周花费的金币总数 (可选)

  // 属性经验统计 (对应 allCharacterStatus)
  collecting    Float @default(0) // 采集经验
  fishing       Float @default(0) // 钓鱼经验
  mining        Float @default(0) // 挖掘经验
  farmingAnimal Float @default(0) // 畜牧经验
  farmingPlant  Float @default(0) // 种植经验
  cooking       Float @default(0) // 烹饪经验
  forging       Float @default(0) // 锻造经验
  sewing        Float @default(0) // 缝纫经验
  manufacturing Float @default(0) // 制造经验
  trading       Float @default(0) // 交易经验
  knowledge     Float @default(0) // 学识经验
  mysterious    Float @default(0) // 神秘经验
  enhance       Float @default(0) // 强化经验
  exploring     Float @default(0) // 探索经验
  luck          Float @default(0) // 幸运经验

  battle       Float @default(0) // 战斗经验
  strength     Float @default(0) // 力量经验
  dexterity    Float @default(0) // 敏捷经验
  intelligence Float @default(0) // 智力经验
  stamina      Float @default(0) // 耐力经验
  attacking    Float @default(0) // 攻击经验
  defencing    Float @default(0) // 防御经验

  // 总计经验
  total Float @default(0) // 所有属性经验总和

