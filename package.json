    "@prisma/extension-read-replicas": "^0.4.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@tailwindcss/vite": "^4.0.5",
    "@vueuse/nuxt": "^14.1.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.2",
    "crawler": "^2.0.2",
    "cropperjs": "^1.6.2",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dayjs-nuxt": "^2.1.11",
    "dotenv": "^16.5.0",
    "driver.js": "^1.3.6",
    "echarts": "^5.6.0",
    "gsap": "^3.13.0",
    "js-yaml": "^4.1.1",
    "nuxt": "^3.15.4",
    "nuxt-auth-utils": "^0.5.20",
    "p-limit": "^6.2.0",
    "pako": "^2.1.0",
    "pdfjs-dist": "^5.0.375",
    "pino": "^9.7.0",
    "pinyin-match": "^1.2.8",
    "qs": "^6.14.0",
    "redis": "^5.5.6",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.0.5",
    "turndown": "^7.2.2",
    "uuid": "^11.1.0",
    "voice-input-button2": "^1.1.9",
    "vue": "latest",
    "vue-echarts": "^7.0.3",
    "vue-router": "latest",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.34"
