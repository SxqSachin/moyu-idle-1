{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/.bin/nuxt build --dotenv .env.production",
    "dev": "node --max-old-space-size=4096 ./node_modules/.bin/nuxt dev --dotenv .env.development",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "serve": "node ./.output/server/index.mjs",
    "generateResource": "node --max-old-space-size=4096 ./tools/generateAssetsResourceScript.js && node --max-old-space-size=4096 ./tools/readExcelEnemies.js && node --max-old-space-size=4096 ./tools/readExcelGameAction.js && node --max-old-space-size=4096 ./tools/readExcelGameResource.js && bun run ./tools/generateAlchemyAction.ts && bun run ./tools/readExcelFarmingAction.ts && bun run ./tools/convertSensitiveToJson.ts  && bun run ./tools/readExcelFishSpecies.js && bun run ./tools/readExcelFishBaits.ts",
    "generateSponsorList": "node ./tools/readSponsorList.js",
    "pack": "npm run generateResource && npm run build && tar -czvf output.tar ./.output",
    "server_deploy": "rm -rf .output && tar xzvf output.tar && pm2 restart DeepApp && rm -rf output.tar",
    "backend_local": "cd childProcess/run-task-standalone && pm2 startOrRestart ecosystem.config.cjs --only 'battle_local,task_local,kitty_local'",
    "backend_prod": "cd childProcess/run-task-standalone && pm2 startOrRestart ecosystem.config.cjs --only 'battle,task,kitty'",
    "stop_backend_local": "cd childProcess/run-task-standalone && pm2 stop battle_local task_local kitty_local",
    "stop_backend_prod": "cd childProcess/run-task-standalone && pm2 stop battle task kitty",
    "backend": "cd childProcess/run-task-standalone && pm2 start ecosystem.config.cjs",
    "stop_backend": "pm2 del battle && pm2 del task && pm2 del ranking && pm2 del kitty",
    "restart_backend": "npm run stop_backend && cd childProcess/run-task-standalone && pm2 start ecosystem.config.cjs",
    "kitty_satiety": "cd childProcess/run-task-standalone && pm2 startOrRestart ecosystem.config.cjs --only 'kitty_satiety'",
    "dispatch_quest": "cd childProcess/run-task-standalone && pm2 startOrRestart ecosystem.config.cjs --only 'dispatch_quest'",
    "build:battle": "esbuild ./childProcess/run-task-standalone/src/process/runBattleProcess.ts --bundle --platform=node --format=esm --target=node18 --outfile=./childProcess/run-task-standalone/dist/runBattleProcess.js --external:*.css --sourcemap"
  },
  "dependencies": {
    "@alicloud/dm20151123": "^1.7.1",
